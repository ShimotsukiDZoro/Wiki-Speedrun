{
  "manifest_version": 3,
  "name": "Wikipedia Speedrun",
  "version": "1.0.0",
  "description": "Race between Wikipedia articles in your regular browser.",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://wikipedia.org/*",
    "https://*.wikipedia.org/*",
    "https://wikimedia.org/*",
    "https://google.com/*",
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wikipedia.org/*",
        "https://*.wikipedia.org/*"
      ],
      "js": ["wikipedia-content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Wikipedia Speedrun",
    "default_popup": "popup.html"
  }
}
